{
  "name": "mase-pos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@10.9.0",
  "engines": {
    "node": ">=22.12.0 <23",
    "npm": ">=10.9.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "npm run typecheck && npm run eslint",
    "typecheck": "tsc --noEmit",
    "eslint": "eslint .",
    "db:init": "tsx server/init-db.ts",
    "test:unit": "cross-env NODE_ENV=test vitest run",
    "test:api": "cross-env NODE_ENV=test vitest run tests/backend/",
    "test:e2e": "cross-env NODE_ENV=test playwright test",
    "test": "npm run test:unit",
    "test:watch": "cross-env NODE_ENV=test vitest",
    "smoke:stocktake": "tsx scripts/stocktake-smoke.ts",
    "ops:verify-endpoint": "tsx scripts/verify-production-endpoint.ts",
    "ops:verify-schema": "tsx scripts/verify-production-schema.ts",
    "seed:test-tenant": "tsx scripts/seed-test-tenant.ts",
    "embed:backfill": "tsx scripts/backfill-embeddings.ts",
    "security:scan": "npm audit --omit=dev"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.12",
    "@ai-sdk/openai": "^4.0.11",
    "@ai-sdk/openai-compatible": "^3.0.7",
    "ai": "^7.0.22",
    "bcryptjs": "^3.0.3",
    "date-fns": "3.6.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "html5-qrcode": "^2.3.8",
    "jsonwebtoken": "^9.0.3",
    "kysely": "^0.29.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.16.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.14.2",
    "recharts": "^3.8.1",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5",
    "tsx": "^4.23.12",
    "web-push": "^3.6.7",
    "zod": "^4.4.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.41.0",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.11.11",
    "@types/socket.io": "^3.0.1",
    "@types/socket.io-client": "^1.4.36",
    "@types/supertest": "^2.0.14",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/ui": "^4.1.10",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^22.1.0",
    "supertest": "^6.3.3",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
